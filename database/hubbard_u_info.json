{
    "_meta": {
        "description": "DFT+U Hubbard parameter database with tiered multi-source values; supports anion-context-dependent U selection",
        "format": "Per element: {L, tier, source, default: {U, J}, contexts: {anion: {U, J}}}",
        "tier_policy": {
            "1": "Official Materials Project MPRelaxSet parameters (Jain 2011); used automatically",
            "2": "MIT RelaxSet / pymatgen built-in parameters; used automatically with explicit source labeling",
            "3": "Literature-recommended values; used automatically, with a report-level reminder to verify system suitability"
        },
        "sources": {
            "MP": "Materials Project MPRelaxSet — Jain et al., PRB 84, 045115 (2011)",
            "MIT": "MIT RelaxSet — pymatgen MITRelaxSet.yaml (Wang, Maxisch, Ceder 2006 framework)",
            "Dudarev_1998": "Dudarev et al., PRB 57, 1505 (1998) — SIC-LSDA fitting",
            "Anisimov_1997": "Anisimov et al., J. Phys.: Condens. Matter 9, 767 (1997)",
            "Lutfalla_2011": "Lutfalla et al., J. Chem. Theory Comput. 7, 2218 (2011) — U fitting for transition-metal oxide systems",
            "Hu_Metiu_2011": "Hu & Metiu, J. Phys. Chem. C 115, 5841 (2011) — catalysis on TiO2/CeO2/ZnO",
            "Cococcioni_2005": "Cococcioni & de Gironcoli, PRB 71, 035105 (2005) — linear-response method",
            "empirical_4f": "Empirical estimates for 4f rare-earth elements (non-MP official; for reference only)"
        },
        "notes": [
            "L: angular momentum quantum number (2=d, 3=f, -1=no U applied)",
            "LDAUTYPE=2 (Dudarev simplified scheme), U_eff = U - J",
            "The anion key in contexts should match the most electronegative bonded element in the system",
            "If the system anion is absent from contexts, use default",
            "Tier-3 U values may differ by approximately ±1-2 eV across literature sources; system-specific validation is essential"
        ]
    },

